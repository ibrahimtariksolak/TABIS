<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>battery_ros2_bridge</name>
  <version>0.1.0</version>
  <description>
    Batarya telemetri platformu ile ROS 2 arasındaki köprü.
    WebSocket üzerinden gelen canlı batarya verisini sensor_msgs/BatteryState
    ve diagnostic_msgs/DiagnosticArray olarak yayınlar.
  </description>
  <maintainer email="ibrahimtariksolak@gmail.com">Ibrahim Tarik Solak</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>std_msgs</depend>

  <exec_depend>python3-websockets</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
